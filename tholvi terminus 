play_random_sound() {
killall -9 paplay ffplay aplay 2>/dev/null

local audio_dir="$HOME/Desktop/audio"  
  
shopt -s nullglob  
local sounds=("$audio_dir"/*.{wav,mp3,ogg,WAV,MP3,OGG})  
shopt -u nullglob  

if [ ${#sounds[@]} -gt 0 ]; then  
    local random_index=$((RANDOM % ${#sounds[@]}))  
    local selected_sound="${sounds[$random_index]}"  

    if command -v paplay &> /dev/null; then  
        paplay "$selected_sound" 2>/dev/null &  
    elif command -v ffplay &> /dev/null; then  
        ffplay -nodisp -autoexit "$selected_sound" &>/dev/null &  
    elif command -v aplay &> /dev/null; then  
        aplay -q "$selected_sound" 2>/dev/null &  
    fi  
fi

}

show_loading_animation() {
for i in $(seq 1 100); do
echo -ne "\r\033[1;31mProcessing command: [${i}%]\033[0m "
sleep 0.01
done
echo -e "\r                                      \r"
}

show_exhausted_loading() {
