useless_trap() {
if [ "$SHELL_READY" -eq 0 ]; then
return 0
fi

if [[ "$BASH_COMMAND" == "exit"* ]] || [[ "$BASH_COMMAND" == "useless_trap"* ]]; then  
    return 0  
fi  

COMMAND_COUNT=$((COMMAND_COUNT + 1))  

trigger_beep  

if [ $((COMMAND_COUNT % 10)) -eq 0 ]; then  
    play_random_sound  

    if command -v cmatrix &> /dev/null; then  
        timeout 3 cmatrix -b -C green 2>/dev/null || true  
        clear  
    fi  

    echo -e "\033[1;31m=================================================="  
    echo -e "😴 i am exhausted"  
    echo -e "==================================================\033[0m"  

